<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 4 adds the minimum permissions for the local-only Network Guardian
         (ADR-003): INTERNET for the on-device DNS forwarding loop and FOREGROUND
         SERVICE for the user-activated tunnel. No VpnService transport tunnel to
         any server exists in this design. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read the device's current DNS resolver so filtering never silently
         changes who resolves the user's names (least-privilege: normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Full package inventory for App Guardian (Phase 5). Device security and
         antivirus apps are a permitted use; requires the Play Permissions
         Declaration Form + prominent disclosure (docs/DRD.md §9). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Record boot events as timestamp facts (Phase 6 Privacy Engine). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SelvardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Selvard"
        android:supportsRtl="true"
        android:theme="@style/Theme.Selvard">

        <!-- Phase 6: install/update/remove + boot facts (system broadcasts only; no polling). -->
        <receiver
            android:name=".privacy.SelvardPackageReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target: explicit user action only (no interception, by design). -->
        <activity
            android:name=".link.CheckLinkActivity"
            android:exported="true"
            android:label="Check link with Selvard">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Network Guardian: user-activated local filter. Never starts silently;
             always behind the in-app prominent-disclosure consent flow (F3). -->
        <service
            android:name=".network.SelvardVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
