<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 4 adds the minimum permissions for the local-only Network Guardian
         (ADR-003): INTERNET for the on-device DNS forwarding loop and FOREGROUND
         SERVICE for the user-activated tunnel. No VpnService transport tunnel to
         any server exists in this design. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Read the device's current DNS resolver so filtering never silently
         changes who resolves the user's names (least-privilege: normal permission). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SelvardApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Selvard"
        android:supportsRtl="true"
        android:theme="@style/Theme.Selvard">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target: explicit user action only (no interception, by design). -->
        <activity
            android:name=".link.CheckLinkActivity"
            android:exported="true"
            android:label="Check link with Selvard">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Network Guardian: user-activated local filter. Never starts silently;
             always behind the in-app prominent-disclosure consent flow (F3). -->
        <service
            android:name=".network.SelvardVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>
